/**
 * 校准曲线：本地实时换算的核心（老板需求 2.4）
 *
 * 设计（与 Docs/family-health-aide.md §3 一致）：
 *   1) 矫正算法只跑在 API 端（原生 E115M 库，唯一事实来源）；
 *   2) API 用探头**自己的真实历史**回放，生成 (原始值 → 矫正值) 映射表，本模块负责拉取 + 缓存；
 *   3) 每条 BLE 读数在本地按 raw 线性插值 → 实时显示矫正值，**0 次网络请求**；
 *   4) 表的版本变了 / TTL 到期 / 探头切换时才重新拉取（一天 1 次量级）。
 *
 * 精度：平台自检实测平均偏差 0.32 mmol/L、最大 1.7 mmol/L（真实探头 15842 条历史）。
 *      APP 在数值旁标注「本地估算 ±」，并在联网时用平台回放值自动对齐。
 */
import { apiCalCurve } from '@/api/index.uts'
import { getCurve, saveCurve } from './store.uts'

export type CalPoint = { raw: number, val: number }

export type CalCurve = {
  probeId: number
  version: string
  unit: string
  scale: number
  tempX10: number
  points: Array<CalPoint>
  avgDiff: number   // 平台自证平均偏差（mmol/L ×10）
  maxDiff: number
  fetchedAt: number
}

const TTL_SEC = 86400 // 一天：曲线只在探头配置/历史变化时才变

function pickNum(o: UTSJSONObject, k: string): number {
  const v = o[k]
  return v == null ? 0 : (v as number)
}

/** 拉取（带 TTL 与版本双重判断）；force=true 强制刷新 */
export async function loadCurve(probeId: number, force: boolean = false): Promise<CalCurve | null> {
  const cached = getCurve(probeId)
  const now = Math.floor(Date.now() / 1000)
  if (!force && cached != null && now - cached.fetchedAt < TTL_SEC && cached.points.length > 0) {
    return cached
  }
  const r = await apiCalCurve(probeId)
  if (r.code != 0 || r.data == null) return cached
  const d = r.data as UTSJSONObject
  const rawPoints = d['points'] as Array<Array<number>> | null
  if (rawPoints == null || rawPoints.length == 0) return cached
  const pts: Array<CalPoint> = []
  rawPoints.forEach((p) => { pts.push({ raw: p[0], val: p[1] } as CalPoint) })
  const acc = d['accuracy'] as UTSJSONObject | null
  const curve: CalCurve = {
    probeId: probeId,
    version: (d['version'] as string | null) ?? '',
    unit: (d['unit'] as string | null) ?? 'mmol/L',
    scale: pickNum(d, 'scale'),
    tempX10: pickNum(d, 'temp_x10'),
    points: pts,
    avgDiff: acc == null ? 0 : pickNum(acc, 'avg_diff'),
    maxDiff: acc == null ? 0 : pickNum(acc, 'max_diff'),
    fetchedAt: now
  } as CalCurve
  saveCurve(curve)
  return curve
}

/** 本地换算：raw → 矫正值（mmol/L ×10），越界取端点；无曲线返回 -1 */
export function toCalibrated(curve: CalCurve | null, raw: number): number {
  if (curve == null) return -1
  const pts = curve.points
  if (pts.length == 0) return -1
  if (raw <= pts[0].raw) return pts[0].val
  if (raw >= pts[pts.length - 1].raw) return pts[pts.length - 1].val
  let lo = 0
  let hi = pts.length - 1
  while (hi - lo > 1) {
    const mid = Math.floor((lo + hi) / 2)
    if (pts[mid].raw <= raw) lo = mid
    else hi = mid
  }
  const x0 = pts[lo].raw
  const y0 = pts[lo].val
  const x1 = pts[hi].raw
  const y1 = pts[hi].val
  if (x1 == x0) return y1
  return Math.round(y0 + (raw - x0) * (y1 - y0) / (x1 - x0))
}

/** 本地估算的不确定度（mmol/L ×10）：接口自证的 max_diff，兜底 30（3.0 mmol/L） */
export function uncertaintyX10(curve: CalCurve | null): number {
  if (curve == null || curve.maxDiff <= 0) return 30
  return Math.max(curve.maxDiff, 10)
}
